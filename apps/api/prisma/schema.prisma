// Prisma schema for Dingo

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lawyer {
  id                String   @id @default(uuid())
  fullNameEn        String
  fullNameHe        String
  city              String
  specialties       String[]
  yearsOfExperience Int
  ratingVector      Json     // { professionalism, availability, empathy, cost }
  caseIds           String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([city])
  @@index([specialties])
}

model Case {
  id                    String    @id @default(uuid())
  externalId            String    @unique
  title                 String
  specialty             String
  result                String
  judgeName             String?
  openedAt              DateTime?
  closedAt              DateTime?
  complexityScore       Float     @default(0.5)
  rawText               String    @db.Text
  plaintiffLawyerIds    String[]  @default([])
  defendantLawyerIds    String[]  @default([])
  associatedLawyerIds   String[]  @default([])
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([externalId])
  @@index([specialty])
  @@index([result])
  @@index([closedAt])
}
