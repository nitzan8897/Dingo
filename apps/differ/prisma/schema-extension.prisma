// IMPORTANT: This is a SUGGESTED schema extension for the Differ service.
// DO NOT use this file directly!
//
// INSTRUCTIONS:
// 1. Review the models below
// 2. Manually merge them into your main Prisma schema file:
//    apps/api/prisma/schema.prisma
// 3. Adjust field names/types to match your existing schema conventions
// 4. The "Lawyer" model below may conflict with your existing one -
//    if so, just add the missing fields to your existing Lawyer model
// 5. After merging, run: `npx prisma migrate dev --name add_case_tables`
// 6. Then run: `npx prisma generate`
//
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// EXISTING MODEL (may already exist in your schema)
// ============================================================================

model Lawyer {
  id                String        @id @default(cuid())
  // NOTE: Your existing Lawyer model may have these fields:
  // fullNameEn, fullNameHe, city, specialties, yearsOfExperience, etc.
  // If so, just add the relation below to your existing model:

  // New relation for case tracking
  cases             LawyerCase[]

  // Existing fields (example - adjust to match your schema):
  // fullNameEn        String
  // fullNameHe        String
  // licenseNumber     String?      @unique
  // city              String
  // specialties       String[]
  // yearsOfExperience Int
  // ratingVector      Json
  // createdAt         DateTime     @default(now())
  // updatedAt         DateTime     @updatedAt
}

// ============================================================================
// NEW MODELS FOR DIFFER
// ============================================================================

model Case {
  id              String        @id @default(cuid())
  externalId      String        @unique    // Unique ID from court system
  title           String                   // Case title (e.g., "Cohen vs. Smith")
  specialty       String                   // Legal domain: CRIMINAL, CIVIL, FAMILY, etc.
  result          String                   // Outcome: win, lose, settlement, dismissed, other
  judgeName       String?                  // Name of the presiding judge
  openedAt        DateTime?                // When the case was opened
  closedAt        DateTime?                // When judgment was given
  complexityScore Float         @default(0.5) // 0-1 score of case complexity
  rawText         String        @db.Text   // Full text of the judgment (for reference)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  lawyers         LawyerCase[]

  @@index([externalId])
  @@index([specialty])
  @@index([result])
  @@index([closedAt])
}

model LawyerCase {
  id        String    @id @default(cuid())
  case      Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId    String
  lawyer    Lawyer    @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  lawyerId  String
  side      String    // plaintiff, defendant, other
  createdAt DateTime  @default(now())

  @@unique([caseId, lawyerId]) // Prevent duplicate lawyer-case pairs
  @@index([caseId])
  @@index([lawyerId])
  @@index([side])
}

